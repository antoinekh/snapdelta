import pytest
from snapdelta.secrets import SECRETS, SecretError

from {{package}}.secrets import {{Class}}Secrets, {{Class}}SecretSettings


def test_the_backend_passes_the_doctor() -> None:
    assert SECRETS.check("{{name}}", {{Class}}Secrets) is None
    assert SECRETS.inspect("{{name}}", {{Class}}Secrets) == []


def test_a_secret_and_a_missing_one(tmp_path) -> None:
    path = tmp_path / "secrets.json"
    path.write_text('{"netconf": "s3cret"}')
    settings = {{Class}}SecretSettings(path=path)
    assert {{Class}}Secrets.read("netconf", settings) == "s3cret"
    with pytest.raises(SecretError, match="no secret 'nope'"):
        {{Class}}Secrets.read("nope", settings)
