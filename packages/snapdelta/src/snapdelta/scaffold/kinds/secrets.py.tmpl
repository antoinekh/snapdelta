"""The secret backend {{name}}: `password = { {{name}} = "REFERENCE" }` in snapdelta.toml."""

import json
from pathlib import Path

from snapdelta.secrets import SecretBackend, SecretError
from snapdelta.settings import SecretBackendSettings


class {{Class}}SecretSettings(SecretBackendSettings):
    """The table [secrets.{{name}}] of snapdelta.toml; replace the file with the URL and the login of a vault."""

    path: Path = Path("secrets.json")


class {{Class}}Secrets(SecretBackend):
    """Reads the secrets of a JSON file of names and values."""

    settings_class = {{Class}}SecretSettings

    @classmethod
    def read(cls, reference: str, settings: SecretBackendSettings) -> str:
        chosen = settings if isinstance(settings, {{Class}}SecretSettings) else {{Class}}SecretSettings()
        try:
            values = json.loads(chosen.path.read_text(encoding="utf-8"))
        except (OSError, ValueError) as error:
            raise SecretError(f"{chosen.path}: {error}") from error
        if reference not in values:
            raise SecretError(f"{chosen.path}: no secret {reference!r}")
        return str(values[reference])
